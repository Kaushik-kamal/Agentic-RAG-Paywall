# ==============================================================================
# AGENTIC RAG PAYWALL — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ==============================================================================

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-to-a-random-32-char-string

# ── Gemini (Google AI) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=knowledge_base
CHROMA_PERSIST_DIR=./data/chroma

# ── Stellar Network ────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet                              # testnet | mainnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SECRET_KEY=your-stellar-secret-key-here
STELLAR_PUBLIC_KEY=your-stellar-public-key-here
X402_PRICE_XLM=0.01                                 # Cost per RAG query

# ── LangChain (optional tracing) ───────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING=false

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_APP_NAME=Agentic RAG Paywall
