# ==============================================================================
# Agentic RAG Paywall — environment reference
#
# Copy the relevant blocks into:
#   backend/.env        (server configuration and secrets)
#   frontend/.env.local (browser configuration — NEXT_PUBLIC_* is public)
#
# Never commit a real .env. Only this file belongs in version control.
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
# backend/.env
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false                   # true in production for structured logs

# ── Security ──────────────────────────────────────────────────────────────────
# Signs x402 access tokens. Leave blank in development and a random key is
# generated per process; REQUIRED and stable in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Guards knowledge-base writes (upload, delete). Required in production.
# The Next.js server reads the same value to proxy uploads without exposing it.
ADMIN_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ── Gemini (https://aistudio.google.com/apikey) ───────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# Availability varies by key and tier — run `python scripts/list_models.py`.
# flash-lite is the default on purpose: reasoning models spend 20s+ thinking
# before the first token, which ruins a streamed answer.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=1536

# ── Vector store ──────────────────────────────────────────────────────────────
CHROMA_COLLECTION=knowledge_base
CHROMA_PERSIST_DIR=./data/chroma

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6                # passages sent to the model
RETRIEVAL_FETCH_K=24             # candidates pulled before fusion
RETRIEVAL_MIN_RELEVANCE=0.15
HYBRID_SEARCH_ENABLED=true       # dense + BM25 with reciprocal rank fusion
RRF_K=60

# ── Ingestion ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/uploads

# ── Persistence ───────────────────────────────────────────────────────────────
DATABASE_URL=./data/paywall.db   # SQLite path (WAL mode)

# ── Stellar x402 ──────────────────────────────────────────────────────────────
# Provision a funded testnet account:  python scripts/setup_stellar.py
STELLAR_NETWORK=testnet          # testnet | public
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PUBLIC_KEY=              # treasury account that receives payments
STELLAR_SECRET_KEY=              # only needed if the server ever sends funds

X402_PRICE_XLM=0.01              # price of one payment
X402_CREDITS_PER_PAYMENT=10      # answers bought per payment
X402_FREE_CREDITS=3              # trial credits for a new agent
X402_CHALLENGE_TTL_SECONDS=300

# Accepts `sandbox_*` transaction hashes without touching the chain so the demo
# runs with zero setup. FORCED OFF when ENVIRONMENT=production.
X402_SANDBOX_MODE=true

XLM_USD_RATE=0.11                # display only


# ══════════════════════════════════════════════════════════════════════════════
# frontend/.env.local
# ══════════════════════════════════════════════════════════════════════════════

# Called directly from the browser — must be reachable from the client.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-side only. Used by the Next.js route handlers that proxy uploads;
# in Docker this is the container hostname rather than localhost.
API_INTERNAL_URL=http://localhost:8000/api/v1

# Must match ADMIN_API_KEY above. Never prefixed with NEXT_PUBLIC_ — that
# would ship it to every visitor.
ADMIN_API_KEY=
